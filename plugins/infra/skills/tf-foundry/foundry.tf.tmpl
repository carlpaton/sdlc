resource "azurerm_cognitive_account" "{{prefix}}-ai" {
  name                = "{{prefix}}-{{service}}-${var.env_id}-ai"
  location            = azurerm_resource_group.{{prefix}}-rg.location
  resource_group_name = azurerm_resource_group.{{prefix}}-rg.name

  kind     = "{{foundry_kind}}" # OpenAI, or AIServices for non-OpenAI models
  sku_name = "S0"

  custom_subdomain_name = "{{prefix}}{{foundry_hex}}" # globally unique

  tags = local.tags
}

resource "azurerm_cognitive_deployment" "{{prefix}}-model" {
  for_each = var.model_deployments

  name                 = each.key
  cognitive_account_id = azurerm_cognitive_account.{{prefix}}-ai.id

  model {
    format  = each.value.format
    name    = each.value.model
    version = each.value.version
  }

  sku {
    name     = each.value.sku
    capacity = each.value.capacity
  }
}

output "ai_endpoint" {
  value = azurerm_cognitive_account.{{prefix}}-ai.endpoint
}

output "ai_deployments" {
  value = keys(azurerm_cognitive_deployment.{{prefix}}-model)
}
