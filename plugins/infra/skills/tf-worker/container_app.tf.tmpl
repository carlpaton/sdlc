resource "azurerm_container_app" "{{prefix}}-aca" {
  container_app_environment_id = azurerm_container_app_environment.{{prefix}}-cae.id
  name                         = "{{prefix}}-{{service}}-${var.env_id}"
  resource_group_name          = azurerm_resource_group.{{prefix}}-rg.name
  revision_mode                = "Single" # Multiple

  template {
    min_replicas = var.container_min_replicas
    max_replicas = var.container_max_replicas

    container {
      name   = "{{prefix}}-{{service}}-${var.env_id}"
      image  = "mcr.microsoft.com/k8se/quickstart:latest" # placeholder, the app pipeline deploys the real image
      cpu    = 0.25
      memory = "0.5Gi"
    }
  }

  # No ingress: a console worker listens on nothing. Add a probe only if the worker exposes a port.

  # The app pipeline owns the image. Without this, the next apply resets it to the placeholder.
  lifecycle {
    ignore_changes = [template[0].container[0].image]
  }

  tags = local.tags
}
