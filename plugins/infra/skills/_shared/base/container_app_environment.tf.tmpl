resource "azurerm_container_app_environment" "{{prefix}}-cae" {
  location                   = azurerm_resource_group.{{prefix}}-rg.location
  name                       = "{{prefix}}-{{service}}-${var.env_id}-cae"
  resource_group_name        = azurerm_resource_group.{{prefix}}-rg.name
  log_analytics_workspace_id = azurerm_log_analytics_workspace.{{prefix}}-law.id

  tags = local.tags
}
