resource "azurerm_storage_account" "{{prefix}}-asa-public" {
  name                     = "{{prefix}}{{blob_public_hex}}" # must be globally unique, lowercase only, max 24 characters
  resource_group_name      = azurerm_resource_group.{{prefix}}-rg.name
  location                 = azurerm_resource_group.{{prefix}}-rg.location
  account_tier             = "Standard"
  account_replication_type = "LRS"

  allow_nested_items_to_be_public = true # Required for public containers. Keep private data out of this account.

  tags = local.tags
}

resource "azurerm_storage_container" "{{prefix}}-asc-public" {
  name                  = "{{prefix}}-public-assets"
  storage_account_id    = azurerm_storage_account.{{prefix}}-asa-public.id
  container_access_type = "blob" # Public read for blob objects only, the container cannot be listed
}

output "public_assets_container_base_url" {
  value       = "${azurerm_storage_account.{{prefix}}-asa-public.primary_blob_endpoint}${azurerm_storage_container.{{prefix}}-asc-public.name}"
  description = "Base URL for public assets"
}
